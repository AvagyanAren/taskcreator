# EdgeFocus API
EDGEFOCUS_BASE_URL=https://edgefocus.ru/api/v1
EDGEFOCUS_TOKEN=tk_23efc4c8d99100e58444e5cee21db91a47fc3a9c

EDGEFOCUS_PROJECT_ID=176
EDGEFOCUS_KANBAN_VIEW_ID=765
EDGEFOCUS_TABLE_VIEW_ID=764
EDGEFOCUS_TARGET_BUCKET=Дизайн
# Колонка для уже завершённых задач. Если дата задачи в прошлом,
# она отправляется сюда автоматически. Пусто = правило выключено.
EDGEFOCUS_DONE_BUCKET=Выпущено

# Web UI base for task links
EDGEFOCUS_WEB_URL=https://edgefocus.ru

# Local backend port (frontend runs on 3000 and proxies /api here)
PORT=3001

# Исполнитель по умолчанию (имя или username в EdgeFocus).
# Пусто = никого не назначать. В тексте задачи можно переопределить: "@nick" или "assign Имя".
EDGEFOCUS_DEFAULT_ASSIGNEE=

# Проставлять start date вместе с end date (та же дата). false = только end date.
EDGEFOCUS_SET_START_DATE=true

# Пароль для входа. Обязателен при публичном деплое, локально можно оставить пустым.
APP_PASSWORD=
