{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": ".",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "types": [
      "node"
    ]
  },
  "include": [
    "src/server",
    "src/api",
    "src/services",
    "src/parser",
    "src/types",
    "src/config",
    "src/scripts",
    "api"
  ]
}
